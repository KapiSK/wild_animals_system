#pragma once
// Copy to transfer_secrets.h (git-ignored).
// Remove any old CAMERA_USE_FTP override when migrating.
#define CAMERA_TRANSFER_MODE 2 // 2=SFTP, 1=FTP, 0=HTTP
#define CAMERA_SFTP_PORT 22
#define CAMERA_SFTP_USER "camera-upload"
// On the Pi: ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub -E sha256
#define CAMERA_SFTP_HOST_FINGERPRINT "SHA256:REPLACE_WITH_VERIFIED_PI_HOST_KEY_FINGERPRINT"
// Place the camera's private key on its SD card. Register its PUBLIC key on Pi.
#define CAMERA_SFTP_KEY_PATH "/ssh/camera_ed25519"
#define CAMERA_SFTP_KEY_PASSPHRASE ""
#define CAMERA_SFTP_REMOTE_ROOT "/transfer"
// Only needed if explicitly selecting FTP (mode 1):
// #define CAMERA_FTP_PORT 2121
// #define CAMERA_FTP_USER "camera"
// #define CAMERA_FTP_PASSWORD "CHANGE_ME"
