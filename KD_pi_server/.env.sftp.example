# Merge these settings into the Pi's existing .env (do not overwrite it).
CLOUD_TRANSFER_MODE=sftp
LOCAL_MODE=False
SFTP_HOST=cloud.example.com
SFTP_PORT=22
SFTP_USER=edge-upload
SFTP_KEY_FILE=/home/wildcam/.ssh/cloud_ed25519
SFTP_KNOWN_HOSTS=/home/wildcam/.ssh/cloud_known_hosts
# Path as seen from inside the SSH chroot, not the cloud host's full path.
SFTP_REMOTE_ROOT=/transfer
SFTP_TIMEOUT=30
# Optional for encrypted private keys. Protect .env with mode 600.
SFTP_KEY_PASSPHRASE=
# MAIN_SERVER_URL remains optional for HTTP heartbeat in sftp mode.
# Set MAIN_SERVER_URL= (empty) if no HTTP heartbeat to the cloud is needed.
