[5]@article{https://doi.org/10.1111/2041-210X.14036,
author = {Whytock, Robin C. and Suijten, Thijs and van Deursen, Tim and Świeżewski, Jędrzej and Mermiaghe, Hervé and Madamba, Nazaire and Mouckoumou, Narcisse and Zwerts, Joeri A. and Pambo, Aurélie Flore Koumba and Bahaa-el-din, Laila and Brittain, Stephanie and Cardoso, Anabelle W. and Henschel, Philipp and Lehmann, David and Momboua, Brice Roxan and Makaga, Loïc and Orbell, Christopher and White, Lee J. T. and Iponga, Donald Midoko and Abernethy, Katharine A.},
title = {Real-time alerts from AI-enabled camera traps using the Iridium satellite network: A case-study in Gabon, Central Africa},
